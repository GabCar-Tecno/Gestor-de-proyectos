# Local secrets for the requirement-files Edge Function.
# Copy to .env and fill in. Never commit .env.
# Run locally with: supabase functions serve requirement-files --env-file .env
# In production, set these with: supabase secrets set ...

# AWS region where the bucket lives, e.g. us-east-1
AWS_REGION=
# Private S3 bucket for requirement documents
AWS_S3_BUCKET=
# Access key of the dedicated IAM user (gestor-requirement-files)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only when using temporary credentials
# AWS_SESSION_TOKEN=
